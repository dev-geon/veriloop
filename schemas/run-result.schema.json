{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-result.schema.json",
  "title": "Veriloop run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "spec_path",
    "exit_reason",
    "blind_mode",
    "relaxation",
    "iterations",
    "acceptance",
    "worker_files",
    "gate_files",
    "gate"
  ],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "spec_path": { "type": "string", "minLength": 1 },
    "exit_reason": {
      "type": "string",
      "enum": [
        "goal_met",
        "iteration_cap",
        "no_progress",
        "blind_context_unavailable",
        "worker_blocked",
        "worker_failed",
        "worker_result_invalid"
      ]
    },
    "blind_mode": { "type": "string", "enum": ["strict"] },
    "relaxation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "reason", "authorization"],
      "properties": {
        "authorized": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "authorization": { "type": ["string", "null"] }
      }
    },
    "iterations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration",
          "verdict",
          "independence",
          "failed_count",
          "warning_count",
          "review_file"
        ],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
          "verdict": {
            "type": "string",
            "enum": ["pass", "pass_with_warnings", "fail"]
          },
          "independence": {
            "type": "string",
            "enum": ["strict", "reduced"]
          },
          "failed_count": { "type": "integer", "minimum": 0 },
          "warning_count": { "type": "integer", "minimum": 0 },
          "review_file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "check", "result", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 },
          "phase": {
            "type": "string",
            "enum": ["loop", "post_deploy", "manual"]
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "deferred"]
          },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preceding_runs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "oracles": {
      "type": "array",
      "items": { "$ref": "#/$defs/oracle" }
    },
    "model_substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "from", "to", "reason", "authorization"],
        "properties": {
          "role": { "type": "string", "enum": ["developer", "fixer", "reviewer", "gate"] },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "authorization": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worker_successions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predecessor", "successor", "reason", "authorization"],
        "properties": {
          "predecessor": { "type": "string", "minLength": 1 },
          "successor": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "authorization": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worker_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gate_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "snapshot", "independence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_run", "hold", "fail", "blocked"]
        },
        "snapshot": { "type": ["string", "null"] },
        "independence": {
          "type": ["string", "null"],
          "enum": ["strict", "reduced", null]
        }
      }
    }
  },
  "$defs": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invariant", "reference", "generator", "budget", "result", "strength", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "invariant": { "type": "string", "minLength": 1, "maxLength": 512 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "generator": { "type": "string", "minLength": 1, "maxLength": 512 },
        "budget": { "type": "string", "minLength": 1, "maxLength": 200 },
        "result": { "type": "string", "enum": ["pass", "fail", "blocked"] },
        "strength": {
          "type": "object",
          "additionalProperties": false,
          "required": ["historical", "rediscovered"],
          "properties": {
            "historical": { "type": "integer", "minimum": 0 },
            "rediscovered": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
