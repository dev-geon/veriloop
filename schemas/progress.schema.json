{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress.schema.json",
  "title": "Veriloop live progress record",
  "description": "Written by scripts/report_progress.py under .agent-review/progress/<id>.json. Advisory only: it never decides a verdict, and reviewers and gates do not read it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["progress_version", "id", "flow", "steps", "step", "step_index", "status", "iteration", "max_iterations", "spec_path", "exit_reason", "note", "started", "updated", "history"],
  "properties": {
    "progress_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "flow": { "type": "string", "enum": ["draft", "work"] },
    "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "step": { "type": "string", "enum": ["survey", "design", "interview", "draft", "preflight", "guess_hunt", "confirm", "develop", "review", "fix", "oracle", "gate", "archive"] },
    "step_index": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["running", "waiting_user", "done", "stopped"] },
    "iteration": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
    "max_iterations": { "type": ["integer", "null"] },
    "spec_path": { "type": ["string", "null"], "maxLength": 512 },
    "exit_reason": { "type": ["string", "null"], "enum": ["goal_met", "iteration_cap", "no_progress", "blind_context_unavailable", "worker_blocked", "worker_failed", "worker_result_invalid", null] },
    "note": { "type": "string", "maxLength": 200 },
    "started": { "type": "string" },
    "updated": { "type": "string" },
    "history": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "step", "status", "iteration", "note"],
        "properties": {
          "at": { "type": "string" },
          "step": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "waiting_user", "done", "stopped"] },
          "iteration": { "type": ["integer", "null"] },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
