{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report.schema.json",
  "title": "Veriloop REVIEW.md summary block",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "work", "spec", "current", "runs", "acceptance", "findings", "open_items"],
  "properties": {
    "report_version": { "type": "string", "const": "1" },
    "work": { "type": "string", "minLength": 1, "maxLength": 200 },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "exit_reason", "gate", "snapshot", "updated"],
      "properties": {
        "run": { "type": "string", "minLength": 1, "maxLength": 200 },
        "exit_reason": { "$ref": "#/$defs/exit_reason" },
        "gate": { "$ref": "#/$defs/gate_status" },
        "snapshot": { "type": ["string", "null"], "maxLength": 200 },
        "updated": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run", "exit_reason", "iterations", "gate", "archive"],
        "properties": {
          "run": { "type": "string", "minLength": 1, "maxLength": 200 },
          "exit_reason": { "$ref": "#/$defs/exit_reason" },
          "iterations": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["iteration", "verdict", "failed_count", "warning_count"],
              "properties": {
                "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
                "verdict": { "type": "string", "enum": ["pass", "pass_with_warnings", "fail"] },
                "failed_count": { "type": "integer", "minimum": 0 },
                "warning_count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "gate": { "$ref": "#/$defs/gate_status" },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "sha256": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "phase", "result", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 200 },
          "phase": { "type": "string", "enum": ["loop", "post_deploy", "manual"] },
          "result": { "type": "string", "enum": ["pass", "fail", "blocked", "deferred"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invariant", "result", "historical", "rediscovered"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "invariant": { "type": "string", "minLength": 1, "maxLength": 512 },
          "result": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "historical": { "type": "integer", "minimum": 0 },
          "rediscovered": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "status", "disposition"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "severity": { "type": "string", "enum": ["failed", "warning"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "status": { "type": "string", "enum": ["open", "pass", "recurred", "accepted"] },
          "disposition": { "type": ["string", "null"], "enum": ["accept", "issue", "cleanup", null] }
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "note"],
        "properties": {
          "kind": { "type": "string", "enum": ["deferred_acceptance", "warning", "discrepancy", "follow_up"] },
          "ref": { "type": "string", "minLength": 1, "maxLength": 300 },
          "note": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "$defs": {
    "exit_reason": {
      "type": "string",
      "enum": [
        "goal_met",
        "iteration_cap",
        "no_progress",
        "blind_context_unavailable",
        "worker_blocked",
        "worker_failed",
        "worker_result_invalid"
      ]
    },
    "gate_status": { "type": "string", "enum": ["not_run", "hold", "fail", "blocked"] }
  }
}
